// Step loops for @INTERP@; CMake writes one of these per interpolator
#include "steps_impl.hpp"
#include "@INTERP@.hpp"

template std::vector<Uint> RK4Integrator::step<TransportElement::Point, @INTERP@>(@INTERP@&, ParticleSet&, const double, const double);
template std::vector<Uint> RK4Integrator::step<TransportElement::Vector, @INTERP@>(@INTERP@&, ParticleSet&, const double, const double);
template std::vector<Uint> RK4Integrator::step<TransportElement::Tensor, @INTERP@>(@INTERP@&, ParticleSet&, const double, const double);
template std::vector<Uint> ExplicitIntegrator::step<TransportElement::Point, @INTERP@>(@INTERP@&, ParticleSet&, const double, const double);
template std::vector<Uint> ExplicitIntegrator::step<TransportElement::Vector, @INTERP@>(@INTERP@&, ParticleSet&, const double, const double);
template std::vector<Uint> ExplicitIntegrator::step<TransportElement::Tensor, @INTERP@>(@INTERP@&, ParticleSet&, const double, const double);
template std::vector<Uint> SpatialIntegrator::step<TransportElement::Point, @INTERP@>(@INTERP@&, ParticleSet&, double, double);
template std::vector<Uint> SpatialIntegrator::step<TransportElement::Vector, @INTERP@>(@INTERP@&, ParticleSet&, double, double);
template void ParticleSet::update_fields<@INTERP@>(@INTERP@&, const double, std::map<std::string, bool>&);
